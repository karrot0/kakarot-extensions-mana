{
  "name": "kakarot_extensions_mana",
  "version": "1.0.0",
  "description": "Kakarot Extensions for Mana app",
  "homepage": "https://karrot0.github.io/kakarot-extensions-mana",
  "author": "Karrot",
  "scripts": {
    "dev": "mana-dev serve --watch",
    "build": "mana-dev build",
    "postbuild": "node scripts/build-page.js",
    "lint": "oxlint src/ lib/ templates/",
    "lint:fix": "oxlint --fix src/ lib/ templates/",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-source.mjs",
    "new-source": "node scripts/new-source.mjs",
    "format": "oxfmt src/ lib/ templates/",
    "format:check": "oxfmt --check src/ lib/ templates/"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@mana-app/dev": "0.2.0",
    "@mana-app/types": "0.1.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "mana": {
    "src": "src/",
    "out": "dist/",
    "target": "es2020",
    "minify": true,
    "platform": "web",
    "repositoryName": "Kakarot Extensions",
    "brandSource": "KakarotComics",
    "thumbnail": "https://raw.githubusercontent.com/karrot0/kakarot-extensions-mana/refs/heads/gh-pages/main/assets/KakarotComics.jpg"
  }
}
